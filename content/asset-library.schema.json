{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Front of House CC0 asset library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "fileTitle", "alt", "author", "sourceUrl", "license", "licenseUrl", "verifiedOn", "sourceWidth", "sourceHeight", "image", "smallImage"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "category": { "type": "string", "minLength": 1 },
          "fileTitle": { "type": "string", "pattern": "^File:" },
          "alt": { "type": "string", "minLength": 1 },
          "author": { "type": "string", "minLength": 1 },
          "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://commons\\.wikimedia\\.org/wiki/File:" },
          "license": { "const": "CC0-1.0" },
          "licenseUrl": { "const": "https://creativecommons.org/publicdomain/zero/1.0/" },
          "verifiedOn": { "type": "string", "format": "date" },
          "sourceWidth": { "type": "integer", "minimum": 1200 },
          "sourceHeight": { "type": "integer", "minimum": 700 },
          "image": { "type": "string", "pattern": "^/images/.*\\.webp$" },
          "smallImage": { "type": "string", "pattern": "^/images/.*\\.webp$" }
        }
      }
    }
  }
}
