{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Front of House showcase content",
  "type": "object",
  "required": ["schemaVersion", "defaultRestaurantName", "defaultColors", "contactEmail", "scenes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "5.0.0" },
    "defaultRestaurantName": { "type": "string", "minLength": 1 },
    "defaultColors": {
      "type": "object",
      "required": ["baseHue", "accentHue"],
      "additionalProperties": false,
      "properties": {
        "baseHue": { "type": "integer", "minimum": 0, "maximum": 359 },
        "accentHue": { "type": "integer", "minimum": 0, "maximum": 359 }
      }
    },
    "contactEmail": { "type": "string", "format": "email" },
    "scenes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layout", "designSignature", "number", "styleLabel", "previewLabel", "heroLine", "heroSupport", "menuLine", "menuSupport", "heroAssetId", "menuAssetId", "tabs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "layout": { "enum": ["cinema", "poster", "journal", "table", "nocturne", "market", "noodle", "tide", "cellar", "checkered", "cantina", "ink", "fire", "patisserie", "botanical", "trattoria", "scoop", "harvest", "fold", "daybreak", "roaster", "shell", "ember", "linen", "ritual", "sticker", "mosaic", "signage", "bonbon", "pass"] },
          "designSignature": { "type": "string", "minLength": 1 },
          "number": { "type": "string", "pattern": "^[0-9]{2}$" },
          "styleLabel": { "type": "string", "minLength": 1 },
          "previewLabel": { "type": "string", "minLength": 1 },
          "heroLine": { "type": "string", "minLength": 1 },
          "heroSupport": { "type": "string", "minLength": 1 },
          "menuLine": { "type": "string", "minLength": 1 },
          "menuSupport": { "type": "string", "minLength": 1 },
          "heroAssetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "menuAssetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "tabs": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["label", "items"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      }
    }
  }
}
